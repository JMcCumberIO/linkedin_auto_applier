# LinkedIn API Credentials
LINKEDIN_CLIENT_ID="YOUR_LINKEDIN_CLIENT_ID"
LINKEDIN_CLIENT_SECRET="YOUR_LINKEDIN_CLIENT_SECRET"
LINKEDIN_REDIRECT_URI="YOUR_LINKEDIN_REDIRECT_URI_HERE"

# OpenAI API Key
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# Encryption Key for securing sensitive data
# This should be a base64 encoded string of 32 random bytes.
# You can generate one using Python:
# python -c "import base64; import os; print(base64.b64encode(os.urandom(32)).decode('utf-8'))"
ENCRYPTION_KEY="YOUR_GENERATED_BASE64_ENCODED_KEY"

# Database URL
# Specifies the connection string for the database.
# Defaults to a local SQLite database if not set.
# Example for PostgreSQL: DATABASE_URL="postgresql://user:password@host:port/dbname"
DATABASE_URL="sqlite:///applications.db"
